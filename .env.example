# Public project URL and publishable key (preferred).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative, used only when no publishable key is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only extraction. Providers: openai (default), moonshot, nvidia, or azure-foundry.
# For Moonshot: AI_PROVIDER=moonshot and AI_MODEL=kimi-k3.
# For NVIDIA API Catalog: AI_PROVIDER=nvidia and AI_MODEL=meta/muse-glimmer-30b.
# For Azure AI Foundry: AI_PROVIDER=azure-foundry, AI_MODEL=gpt-5, and
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/responses.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AZURE_FOUNDRY_ENDPOINT=

# Optional future server-only secret. This application never needs it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional verification: two distinct confirmed disposable test accounts.
# Keep passwords in .env.local, never NEXT_PUBLIC_ variables.
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
# Optional: also verify the running app's authenticated routes.
# APP_BASE_URL=http://localhost:3000
# Optional Khmer font for generated live AI fixtures (path depends on OS).
# VERIFY_KHMER_FONT_FILE=
