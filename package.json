    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "verify:app": "tsx scripts/verify-app.ts",
    "verify:ai": "node --conditions=react-server --import tsx scripts/verify-ai.ts",
    "evaluate:ai": "node --conditions=react-server --import tsx scripts/evaluate-ai.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "verify:password": "node --conditions=react-server --import tsx scripts/verify-password.ts",
    "cleanup:drafts": "node --conditions=react-server --import tsx scripts/cleanup-drafts.ts",
    "verify:drafts": "node --conditions=react-server --import tsx scripts/verify-drafts.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-khmer": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
